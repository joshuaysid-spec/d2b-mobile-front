# 환경 변수 템플릿 — Git 커밋용. 실제 값은 .env.development / .env.production 에 작성.
# VITE_USE_MOCK: 'false' 가 아니면 목업 모드(안전 기본값). 폐쇄망 실연동 시 false.
VITE_API_BASE_URL=https://api.example.com
VITE_USE_MOCK=true
VITE_BRIDGE_DEBUG=false
# OZ 리포트 뷰어(폐쇄망 OZ 서버). 예: http://oz.internal/oz/html5viewer/ · http://oz.internal/oz/server
VITE_OZ_VIEWER_URL=
VITE_OZ_SERVLET_URL=
